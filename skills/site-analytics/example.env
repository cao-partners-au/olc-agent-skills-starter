# site-analytics config. Copy to site.env and fill in. No secrets in this file: point at files.
PLAUSIBLE_SITE=example.com
PLAUSIBLE_API_KEY_FILE=~/secrets/plausible_stats_key.txt
# Goal names exactly as in Plausible (up to 4, in this order -> goal_1..goal_4 in history)
PLAUSIBLE_GOALS=enquiry,booking,Form: Submission
CLARITY_TOKEN_FILE=~/secrets/clarity_export_token.txt
# History store: sqlite:~/site-analytics.db  (or: supabase, with SUPABASE_URL + SUPABASE_KEY_FILE)
HISTORY=sqlite:~/site-analytics.db
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY_FILE=~/secrets/supabase_service_key.txt
# Optional CRM export: created_at, landing_page (or ad_id), booked, showed, won
# LEADS_CSV=~/exports/leads.csv
